<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing from this app is backed up: the local data is encrypted with
   a key that stays on the phone (it cannot be restored elsewhere), and
   the cloud copy in Firestore is the real backup.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
